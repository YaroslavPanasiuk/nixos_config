<?xml version="1.0" encoding="UTF-8"?>
<actions>
<action>
	<icon>utilities-terminal</icon>
	<name>Open Terminal Here</name>
	<submenu></submenu>
	<unique-id>1734996864522581-1</unique-id>
	<command>exo-open --working-directory %f --launch TerminalEmulator</command>
	<description>Example for a custom action</description>
	<range></range>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
</action>
<action>
	<icon></icon>
	<name>Set as Background</name>
	<submenu></submenu>
	<unique-id>1736289966286446-1</unique-id>
	<command>set_as_wallpaper.sh %f</command>
	<description>Set .png, .jpg, .gif or .mp4 file as a wallpaper</description>
	<range>*</range>
	<patterns>*</patterns>
	<image-files/>
	<video-files/>
</action>
<action>
	<icon></icon>
	<name>Copy path</name>
	<submenu></submenu>
	<unique-id>1736326616331956-1</unique-id>
	<command>echo -n %f | wl-copy</command>
	<description>Copy whole file path</description>
	<range>*</range>
	<patterns>*</patterns>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>
<action>
	<icon></icon>
	<name>Resize and blur</name>
	<submenu></submenu>
	<unique-id>1741004813671915-1</unique-id>
	<command>resize_and_blur.sh -i %F</command>
	<description>Resizes all selected images and videos to 1920*1080 perserving aspect ratio and blurs the backgound layer</description>
	<range>*</range>
	<patterns>*</patterns>
	<image-files/>
	<video-files/>
</action>
<action>
	<icon></icon>
	<name>Extract images</name>
	<submenu></submenu>
	<unique-id>1741004813671916-1</unique-id>
	<command>export_images.sh %f</command>
	<description>Extracts all slides of .pptx or .pdf file as images into a separate folder</description>
	<range>*</range>
	<patterns>*.pdf;*.pptx;*.odp;*.key</patterns>
	<other-files/>
	<text-files/>
</action>
<action>
	<icon></icon>
	<name>Generate presentation</name>
	<submenu></submenu>
	<unique-id>1741004813671917-1</unique-id>
	<command>images_to_pptx.sh -i %F</command>
	<description>Merges all image files in current folder into a .pptx presentation</description>
	<range>*</range>
	<patterns>*</patterns>
	<image-files/>
</action>
<action>
	<icon></icon>
	<name>Convert to .jpg</name>
	<submenu></submenu>
	<unique-id>1741004813671990-1</unique-id>
	<command>magick mogrify -format jpg %f</command>
	<description>Converts image file into .jpg</description>
	<range>*</range>
	<patterns>*</patterns>
	<image-files/>
</action>
<action>
	<icon></icon>
	<name>Convert to davinci format</name>
	<submenu></submenu>
	<unique-id>1741004813671991-1</unique-id>
	<command>kitty  --hold --detach nvidia-offload ffmpeg -i %f -c:v dnxhd -profile:v dnxhr_hq -pix_fmt yuv422p -c:a pcm_s16le %f.mov</command>
	<description>Converts .mp4 video to .mov so that it can be processed by free version of davinci resolve</description>
	<range>*</range>
	<patterns>*</patterns>
	<video-files/>
</action>
<action>
	<icon></icon>
	<name>Convert from davinci format</name>
	<submenu></submenu>
	<unique-id>1741004813671992-1</unique-id>
	<command>kitty  --hold --detach nvidia-offload ffmpeg -i %f -c:v libx264 -crf 18 -c:a aac -b:a 192k %f.mp4</command>
	<description>Converts .mkv video exported from davinci rsolve to regular .mp4</description>
	<range>*</range>
	<patterns>*.mov;*.mkv;</patterns>
	<video-files/>
</action>
<action>
	<icon>gtk-convert</icon>
	<name>.pdf</name>
	<submenu>Convert to ...</submenu>
	<unique-id>1741004813671921-1</unique-id>
	<command>convert_presentation.sh pdf %f</command>
	<description>Converts .pptx, .odp or .key presentation to .pdf</description>
	<range>*</range>
	<patterns>*.pptx;*.odp;*.key</patterns>
	<other-files/>
	<text-files/>
</action>
<action>
	<icon>gtk-convert</icon>
	<name>.pptx</name>
	<submenu>Convert to ...</submenu>
	<unique-id>1741004813671922-1</unique-id>
	<command>convert_presentation.sh pptx %f</command>
	<description>Converts .pdf, odp or .key presentation to .pptx</description>
	<range>*</range>
	<patterns>*.pdf;*.odp;*.key</patterns>
	<other-files/>
	<text-files/>
</action>
<action>
	<icon>gtk-convert</icon>
	<name>.odp</name>
	<submenu>Convert to ...</submenu>
	<unique-id>1741004813671923-1</unique-id>
	<command>convert_presentation.sh odp %f</command>
	<description>Converts .pdf, pptx or .key presentation to .pptx</description>
	<range>*</range>
	<patterns>*.pptx;*.key;*.pdf</patterns>
	<other-files/>
	<text-files/>
</action>
<action>
    <icon>peazip</icon>
    <name>Extract to current folder</name>
    <unique-id>peazip-extract</unique-id>
    <command>ouch decompress %F</command>
    <description>Extract selected files</description>
    <patterns>*</patterns>
    <other-files/>
</action>
<action>
    <icon>peazip</icon>
    <name>Add to Archive</name>
    <unique-id>peazip-add</unique-id>
    <command>ouch compress -y %F %d/archive.zip</command>
    <description>Compress selected files</description>
    <patterns>*</patterns>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
</action>
</actions>